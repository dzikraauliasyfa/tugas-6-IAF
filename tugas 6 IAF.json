    {
      "parameters": {
        "jsCode": "// Output teks dari Basic LLM Chain\nconst llmOutput = $json.text;\n\n// Message ID diambil dari Gmail Trigger\nconst emailMessageId = $('Gmail Trigger').item.json.id;\n\n// Regex untuk menemukan \"Skor: angka\"\nconst match = llmOutput.match(/Skor:\\s*(\\d+)/i);\n\nlet score = 0;\nif (match && match[1]) {\n  score = parseInt(match[1], 10);\n}\n\nreturn {\n  json: {\n    score: score,\n    messageId: emailMessageId\n  }\n};"
